# TECH AI | Smart Way - Environment Configuration

APP_NAME="TECH AI | Smart Way"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000
SECRET_KEY="tech-ai-smart-way-secure-jwt-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supports SQLite out of box & MySQL 8.x)
DATABASE_URL="sqlite:///./tech_ai.db"
# Example MySQL 8.x: DATABASE_URL="mysql+pymysql://root:password@localhost:3306/tech_ai_db"

# AI Configuration (Google Gemini)
GEMINI_API_KEY=""
